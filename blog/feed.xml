---
layout: null
title: Blog Feed
---
<?xml version="1.0" encoding="utf-8"?>
{% comment %}
  Hand-written to match atom.xml and rss.xml, which this site has always
  maintained by hand. jekyll-feed was tried here and removed: it always emits
  an extra site-wide /feed.xml mixing papers and posts, with no config to
  suppress it, and its `categories` option produced a second copy rather than
  replacing the main feed.
{% endcomment %}
<feed xmlns="http://www.w3.org/2005/Atom">

 <title>{{ site.title }} — Blog</title>
 <link href="{{ site.production_url }}/blog/feed.xml" rel="self"/>
 <link href="{{ site.production_url }}/blog/"/>
 <updated>{{ site.time | date_to_xmlschema }}</updated>
 <id>{{ site.production_url }}/blog/</id>
 <author>
   <name>{{ site.author.name }}</name>
   <email>{{ site.author.email }}</email>
 </author>

 {% assign blog_posts = site.posts | where: 'category', 'blog' %}
 {% for post in blog_posts %}
 <entry>
   <title>{{ post.title }}</title>
   <link href="{{ site.production_url }}{{ post.url }}"/>
   <updated>{{ post.date | date_to_xmlschema }}</updated>
   <id>{{ site.production_url }}{{ post.id }}</id>
   {% if post.description %}<summary>{{ post.description | xml_escape }}</summary>{% endif %}
   <content type="html">{{ post.content | xml_escape }}</content>
 </entry>
 {% endfor %}

</feed>
